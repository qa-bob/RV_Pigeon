{
  "name": "rv-pigeon",
  "private": true,
  "workspaces": [
    "shared",
    "api",
    "agent",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:shared": "npm run build -w shared",
    "test:api": "npm run test -w api",
    "lint": "eslint .",
    "format": "prettier --check .",
    "deploy:web": "powershell -ExecutionPolicy Bypass -File scripts/deploy-web.ps1",
    "deploy:api": "powershell -ExecutionPolicy Bypass -File scripts/deploy-api.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "typescript-eslint": "^8.3.0"
  }
}
