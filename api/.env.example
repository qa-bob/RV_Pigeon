# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/rv_pigeon

# Secret used to sign dashboard JWTs (single-host login)
JWT_SECRET=change-me-to-a-long-random-value

# Shared secret the local agent must present on every /agent/* request.
# Must match agent/.env's SERVICE_TOKEN exactly.
AGENT_SERVICE_TOKEN=change-me-to-a-long-random-value

PORT=4000
