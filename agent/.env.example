# Base URL of the RV_Pigeon API (api/ package)
API_BASE_URL=http://localhost:4000

# Must match api/.env's AGENT_SERVICE_TOKEN exactly.
SERVICE_TOKEN=change-me-to-a-long-random-value

# Outdoorsy login is NOT stored here. It is entered once via the agent's
# credential-store setup step and encrypted at rest on this machine only
# (Windows DPAPI). See specs/001-outdoorsy-scheduled-messaging/research.md
# and Constitution Principle I. Never add Outdoorsy credentials to this file.
